# Copy to supabase/functions/.env for local `supabase functions serve`,
# or set in production with:  supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
# Optional. Spec §11 asks for a small/fast model; override if needed.
PARSER_MODEL=claude-haiku-5-5

# Billing (Phase 7). RevenueCat › Integrations › Webhooks › Authorization
# header = "Bearer <REVENUECAT_WEBHOOK_SECRET>".
REVENUECAT_WEBHOOK_SECRET=
# Razorpay (direct/web payments only; store builds use RevenueCat).
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay plan ids per Aria plan and period.
RAZORPAY_PLAN_PERSONAL_MONTH=
RAZORPAY_PLAN_PERSONAL_YEAR=
RAZORPAY_PLAN_FAMILY_MONTH=
RAZORPAY_PLAN_FAMILY_YEAR=
RAZORPAY_PLAN_TEAM_MONTH=
RAZORPAY_PLAN_TEAM_YEAR=

# WhatsApp reminders (Meta Cloud API). WHATSAPP_PROVIDER=meta to send;
# anything else only logs. CRON_SECRET must match Vault 'aria_cron_secret'.
WHATSAPP_PROVIDER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aria_reminder
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=

# Renewal reminders. EMAIL_PROVIDER=resend to send; anything else logs.
WHATSAPP_RENEWAL_TEMPLATE=aria_renewal
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Aria <hello@your-domain>
